# bot token from @BotFather
BOT_TOKEN=

# key that encrypts Jabber passwords in the bot database: openssl rand -base64 32
# lose it and the bot can't log into the accounts (ours can be reset, connected ones must be re-added)
SECRET_KEY=

# domain of our Jabber server (A record to this server, ports 5222, 5269, 80 open)
XMPP_DOMAIN=xmpp.example.com
# email for Let's Encrypt
ACME_EMAIL=admin@example.com

# our JMP promo (referral) code, used for activation when the person has no code of their own
JMP_PROMO_CODE=
# JMP account currency: USD or CAD
JMP_CURRENCY=USD
# how many numbers to request per search (JMP allows up to 500)
JMP_SEARCH_LIMIT=50
# JMP gateway (no need to change)
JMP_JID=cheogram.com

# numbers a person can get through the bot (connected Jabber accounts with their own number don't count)
MAX_NUMBERS_PER_USER=1
# own Jabber accounts a person can connect
MAX_IMPORTS_PER_USER=3

# interface language for people whose Telegram language is unknown: en or ru
DEFAULT_LANG=en
# "Source code" link at the bottom of the home screen; an empty string removes it
SOURCE_URL=https://py.md/jmp-in-tele
# comma-separated Telegram ids; empty — the bot is open to everyone
ALLOWED_USERS=
# admin ids — signup errors are sent here
ADMIN_IDS=

# log all XMPP traffic (to debug JMP forms)
XMPP_DEBUG=0

# for running locally without Docker (npm start); docker-compose overrides these
XMPP_SERVICE=xmpp://127.0.0.1:5223
EJABBERD_API=http://127.0.0.1:5280/api
DB_PATH=data/jmpbot.db
