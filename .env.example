# токен бота от @BotFather
BOT_TOKEN=

# домен нашего джаббер-сервера (A-запись на этот сервер, открыты порты 5222, 5269, 80)
XMPP_DOMAIN=xmpp.example.com
# email для Let's Encrypt
ACME_EMAIL=admin@example.com

# наш промокод (referral code) JMP — подставляется при активации каждого номера
JMP_PROMO_CODE=
# валюта аккаунта JMP: USD или CAD
JMP_CURRENCY=USD
# сколько номеров запрашивать за один поиск (максимум у JMP — 500)
JMP_SEARCH_LIMIT=50
# шлюз JMP (менять не нужно)
JMP_JID=cheogram.com

# сколько номеров можно одному юзеру
MAX_NUMBERS_PER_USER=1
# сколько своих джабберов можно привязать одному юзеру
MAX_IMPORTS_PER_USER=3

# ссылка «Исходный код» внизу главного меню; пустая строка — без ссылки
SOURCE_URL=https://github.com/justkiddingxd/jmp-in-telegram
# id через запятую; пусто — бот открыт для всех
ALLOWED_USERS=
# id админов — сюда летят ошибки регистрации
ADMIN_IDS=

# логировать весь xmpp-трафик (для отладки форм JMP)
XMPP_DEBUG=0

# для локального запуска без docker (npm start); в docker-compose переопределяются
XMPP_SERVICE=xmpp://127.0.0.1:5223
EJABBERD_API=http://127.0.0.1:5280/api
DB_PATH=data/jmpbot.db
